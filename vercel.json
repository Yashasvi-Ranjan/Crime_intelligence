{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/generated/**,data/sample/**,backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://oxide-packages-textiles-carrier.trycloudflare.com/api/$1" },
    { "source": "/api", "destination": "https://oxide-packages-textiles-carrier.trycloudflare.com/api" }
  ]
}
