{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/generated/**,data/sample/**,backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/offline-api/(.*)",
      "destination": "/api/index.py?_route=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://aegis-backend-1ino.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://aegis-backend-1ino.onrender.com/api"
    }
  ]
}
