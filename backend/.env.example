# ==============================================================================
# Cross-Station Crime Intelligence — Backend Configuration
# Verified for Local Zetaris Docker Installation (Ports: 3000, 8888, 8889, 10000)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp backend/.env.example backend/.env
# 2. Set ZETARIS_ENABLED=true
# 3. Fill in your ZETARIS_PASSWORD (or ZETARIS_API_TOKEN)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zetaris Activation Toggle
# Set to 'true' to query live Zetaris; 'false' uses verified local synthetic data.
# ------------------------------------------------------------------------------
ZETARIS_ENABLED=true

# ------------------------------------------------------------------------------
# 2. Local Docker REST API Settings
# The local docker container 'zetaris-api-1' exposes REST on 8888 & auth on 8889.
# ------------------------------------------------------------------------------
ZETARIS_BASE_URL=http://localhost:8888
ZETARIS_AUTH_URL=http://localhost:8889
ZETARIS_ORG_ID=1

# ------------------------------------------------------------------------------
# 3. Authentication Credentials
# Option A: Login with the username and password used at http://localhost:3000
# (Default administrator is typically admin@zetaris.com)
# ------------------------------------------------------------------------------
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=YOUR_ZETARIS_PASSWORD_HERE

# Option B (Alternative): Direct Personal API Token from Zetaris UI (if generated)
# If provided, the adapter uses this token directly without calling legacy-login.
ZETARIS_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Query Engine & JDBC Settings
# The 'zetaris-driver-1' container exposes the Spark/HiveServer2 Thrift port on 10000.
# ------------------------------------------------------------------------------
ZETARIS_JDBC_HOST=localhost
ZETARIS_JDBC_PORT=10000
ZETARIS_DATABASE=default
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_MAX_QUERY_ROWS=500

# ------------------------------------------------------------------------------
# 5. Zetaris Table / Namespace Mapping
# Corresponds to tables registered in Zetaris NDP File Store.
# ------------------------------------------------------------------------------

ZETARIS_TABLE_POLICE_INCIDENTS=police_incidents
ZETARIS_TABLE_NEWSPAPER_REPORTS=newspaper_reports
ZETARIS_TABLE_WITNESS_REPORTS=witness_reports
ZETARIS_TABLE_CCTV_REPORTS=cctv_reports
ZETARIS_TABLE_FORENSIC_REPORTS=forensic_reports

# ------------------------------------------------------------------------------
# 6. Local Fallback Data Directory
# Used automatically whenever ZETARIS_ENABLED=false or before credentials are set.
# Ground truth (data/evaluation/ground_truth.json) is NEVER loaded or queried.
# ------------------------------------------------------------------------------
LOCAL_DATA_DIR=../data/generated

# ------------------------------------------------------------------------------
# 7. FastAPI Backend & CORS Settings
# ------------------------------------------------------------------------------
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# 8. Nightshift AI Provider — NVIDIA Nemotron via Meterless Nightshift
#
# Nightshift is a local proxy installed with the Meterless desktop app.
# It routes all model requests through NVIDIA's inference API on your behalf.
#
# HOW TO FIND YOUR TOKEN:
#   The proxy token is stored automatically at:
#     ~/Library/Application Support/ai.meterless.runtime/proxy-token  (macOS)
#   The backend reads this file automatically — you do NOT need to copy the
#   token here unless you want to override it with a specific key.
#
# HOW TO CHECK THE URL:
#   Nightshift listens on http://127.0.0.1:8088 by default.
#   Confirm with:  lsof -iTCP:8088 -sTCP:LISTEN
#
# NIGHTSHIFT_API_KEY: Leave blank to auto-read from proxy-token file (recommended).
#   Set explicitly only if running in a headless/CI environment where the
#   Nightshift desktop app is not present.
# ------------------------------------------------------------------------------
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIGHTSHIFT_APP_NAME=crime-intel
NIGHTSHIFT_TIMEOUT_SECONDS=90
NIGHTSHIFT_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 9. Meterless World Model Engine
#
# The Meterless Engine is the Node.js worldmodel.js runtime bundled inside
# Nightshift.app. It provides the shared in-memory state between agents
# (Planner, Finder, Skeptic, Reporter) during each investigation run.
#
# METERLESS_WORLD_MODEL_PATH:
#   Default path where worldmodel.js is installed by Meterless Nightshift on macOS.
#   Override this if Nightshift was installed to a non-standard location.
#
# METERLESS_WORLD_DIR:
#   Where investigation world state is persisted between agents during a run.
#   Leave blank to use the Meterless runtime default:
#     ~/Library/Application Support/ai.meterless.runtime/world
# ------------------------------------------------------------------------------
METERLESS_WORLD_MODEL_PATH=/Applications/Nightshift.app/Contents/Resources/engine/js/engine/worldmodel.js
METERLESS_WORLD_DIR=

# ------------------------------------------------------------------------------
# 9b. Role -> model registry (all calls go through Nightshift)
#
# IDs are verified against Nightshift's GET /v1/models at runtime. A configured
# model Nightshift does not list is reported UNAVAILABLE and the role falls back to
# the Lightning text model (NIGHTSHIFT_MODEL) - the report says so.
# Leave a role blank to use NIGHTSHIFT_MODEL (Lightning).
#   Embedding / rerank use different Nightshift operations than chat; they are probed
#   separately and are NOT enabled unless the route actually answers.
# ------------------------------------------------------------------------------
NIGHTSHIFT_MODEL_PLANNER=
NIGHTSHIFT_MODEL_FINDER=
NIGHTSHIFT_MODEL_SKEPTIC=nvidia/nemotron-3-ultra-550b-a55b
NIGHTSHIFT_MODEL_REPORTER=
NIGHTSHIFT_MODEL_EMBEDDING=nvidia/nemotron-3-embed-1b
NIGHTSHIFT_MODEL_RERANK=
NIGHTSHIFT_MODEL_FALLBACK=
NIGHTSHIFT_SKEPTIC_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 9c. Investigation workflow budgets (bounded: it always terminates)
# ------------------------------------------------------------------------------
WORKFLOW_MAX_ITERATIONS=3
WORKFLOW_MAX_MODEL_CALLS=24
WORKFLOW_TIME_BUDGET_SECONDS=900
WORKFLOW_RETRIEVAL_LIMIT=10
WORKFLOW_EVIDENCE_LIMIT_PER_SOURCE=8

# ------------------------------------------------------------------------------
# 9d. Meterless Engines: H-MEM, Scout Intent, Markovian
#     Real engine modules shipped inside Nightshift.app, run through Node.
#     STATE_DIR holds Markovian run state and the H-MEM store (gitignored).
# ------------------------------------------------------------------------------
METERLESS_ENGINE_DIR=/Applications/Nightshift.app/Contents/Resources/engine/js/engine
HMEM_ENABLED=true
HMEM_SCOPE=crime-intel
STATE_DIR=../.state

# ------------------------------------------------------------------------------
# 10. Sample Mode
#
# When SAMPLE_MODE=true every investigation request uses pre-built offline
# scenarios instead of calling Zetaris or Nightshift. Useful for demos,
# screenshots, and CI environments without live integrations.
#
# Can also be toggled per-request via the API:
#   POST /api/investigations/analyze  { "sample_mode": true }
# ------------------------------------------------------------------------------
SAMPLE_MODE=false
