*.pem
*.key
*.p12
*.pfx
id_rsa*
proxy-token
nightshift_token
# image exports and local compose overrides
*.tar
*.tar.gz
docker-compose.override.yml
# every node_modules, not just frontend's
node_modules/
# Python virtualenvs / bytecode
.venv/
venv/
*.pyc
